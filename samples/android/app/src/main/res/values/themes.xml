<resources>
    <!--
        Compose renders its own MaterialTheme, so all we need from the Android
        theme is a bare, action-bar-less container. Inheriting from the
        platform DeviceDefault theme avoids pulling in AppCompat or the
        Material XML themes package.
    -->
    <style name="Theme.Sample" parent="android:Theme.DeviceDefault.NoActionBar" />
</resources>
