<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!--
            Auto-register the lifecycle bridge on process start so ProcessLifecycleOwner
            and ComponentCallbacks2 are wired before the app can call FoundryLocal.create.
            Apps can disable this by adding a `tools:node="remove"` entry for the
            provider in their manifest.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.microsoft.ai.foundry.local.mobile.lifecycle.LifecycleInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
