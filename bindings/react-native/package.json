{
  "name": "@foundry-local/react-native",
  "version": "0.2.0",
  "description": "React Native SDK for path-based ONNX Runtime GenAI inference.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "android/build.gradle",
    "android/src",
    "ios",
    "FoundryLocal.podspec",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
