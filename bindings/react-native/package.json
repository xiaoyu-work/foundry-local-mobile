    "lint": "eslint 'src/**/*.{ts,tsx}'"
  },
  "keywords": [
    "react-native",
    "foundry-local",
    "on-device-llm",
    "onnx-runtime",
    "genai",
    "turbomodule"
  ],
  "repository": "https://github.com/microsoft/foundry-local-mobile",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.6",
    "@types/react-native": "^0.72.8",
    "react": "18.2.0",
    "react-native": "0.75.4",
    "typescript": "5.4.5"
  },
  "codegenConfig": {
    "name": "RNFoundryLocalSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.foundrylocal.reactnative"
    }
